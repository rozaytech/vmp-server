# =========================================================
# TURSO — Base de Dados SQLite na Cloud (Persistente)
# =========================================================
# Substitua pelos valores reais da sua base Turso
# NUNCA commite o ficheiro .env para o Git!
# =========================================================

TURSO_DATABASE_URL=libsql://vmp-saas-db-seuusuario.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# (Opcional) Chave secreta para assinatura de licencas
LICENSE_SECRET=vmp-saas-secret-2026

# (Opcional) SendGrid API Key para emails
SENDGRID_API_KEY=SG.seu-key-aqui

# (Opcional) Resend API Key (alternativa ao SendGrid)
RESEND_API_KEY=re_seu-key-aqui
